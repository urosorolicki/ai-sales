# ai-sales-machine environment template
# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env
#
# REQUIRED  = the stack will not start or will not work correctly without it
# OPTIONAL  = only needed once the corresponding phase is implemented

# ---------------------------------------------------------------------------
# Core / general                                              REQUIRED
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=aisales
GENERIC_TIMEZONE=Europe/Belgrade
TZ=Europe/Belgrade

# ---------------------------------------------------------------------------
# PostgreSQL                                                  REQUIRED
# ---------------------------------------------------------------------------
POSTGRES_USER=aisales
POSTGRES_PASSWORD=
POSTGRES_DB=aisales
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side bind address for the published port. Keep on loopback.
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_BIND_PORT=5432

# ---------------------------------------------------------------------------
# Redis                                                       REQUIRED
# ---------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_BIND_ADDR=127.0.0.1
REDIS_BIND_PORT=6379

# ---------------------------------------------------------------------------
# n8n                                                         REQUIRED
# ---------------------------------------------------------------------------
# Public hostname Caddy will serve. Placeholder until a real domain exists.
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
# Host-side bind for direct access (bypassing Caddy). Keep on loopback.
N8N_BIND_ADDR=127.0.0.1
N8N_BIND_PORT=5678
# Generate once and never rotate without re-entering all n8n credentials:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Basic auth in front of the n8n UI. Leave enabled until SSO/OIDC is in place.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=
# Full external URL used for webhooks. Must match what Caddy serves.
WEBHOOK_URL=https://n8n.example.com/
N8N_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Caddy                                                       REQUIRED
# ---------------------------------------------------------------------------
CADDY_DOMAIN=n8n.example.com
# Used by Let's Encrypt for expiry notices.
CADDY_EMAIL=
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# ---------------------------------------------------------------------------
# Ollama (local LLM)                                          REQUIRED
# ---------------------------------------------------------------------------
# Ollama runs natively on the host, not in a container: a container on macOS has
# no Metal access and would run on the CPU. docker-compose.yml maps the hostname
# "ollama" to the host gateway, so this URL works unchanged from inside n8n.
# See docs/ollama.md.
OLLAMA_BASE_URL=http://ollama:11434
# Default local model for cheap/bulk work (classification, extraction).
OLLAMA_MODEL=llama3.1:8b
# Research runs on a larger context window than triage: the research schema
# plus a page of fetched material does not fit in the default 4096 tokens.
OLLAMA_RESEARCH_MODEL=qwen9-64k:latest
# Scoring reads the rubric, the research output and every signal at once, so it
# needs the same large window as research.
OLLAMA_SCORING_MODEL=qwen9-64k:latest
OLLAMA_KEEP_ALIVE=10m

# ---------------------------------------------------------------------------
# External LLM (higher-quality reasoning)                     REQUIRED
# ---------------------------------------------------------------------------
# Used for research, scoring rationale, outreach drafting and conversation.
LLM_PROVIDER=anthropic
LLM_API_BASE=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Telegram control plane                                      OPTIONAL (Phase 3)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Only this chat id is allowed to issue commands.
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# ---------------------------------------------------------------------------
# Lead data provider                                          OPTIONAL (Phase 4)
# ---------------------------------------------------------------------------
APOLLO_API_KEY=
APOLLO_API_BASE=https://api.apollo.io/v1
# Hard ceiling on provider credits consumed per day.
APOLLO_DAILY_LIMIT=100

# ---------------------------------------------------------------------------
# Email / outreach delivery                                   OPTIONAL (Phase 7)
# ---------------------------------------------------------------------------
# One of: smtp | resend | postmark | sendgrid
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_REPLY_TO=
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
# IMAP for the reply watcher (WF-08).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# ---------------------------------------------------------------------------
# Outreach safety rails                                       REQUIRED
# ---------------------------------------------------------------------------
# Phase 1-7 MUST stay false. Nothing is sent without human approval.
OUTREACH_AUTOSEND_ENABLED=false
OUTREACH_DAILY_LIMIT=20
OUTREACH_PER_DOMAIN_LIMIT=1
OUTREACH_MIN_SCORE=60
OUTREACH_FOLLOWUP_MAX=2
OUTREACH_FOLLOWUP_DELAY_DAYS=4
# Global kill switch honoured by every dispatch workflow.
OUTREACH_PAUSED=true

# ---------------------------------------------------------------------------
# Backups                                                     OPTIONAL
# ---------------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Passphrase for gpg symmetric encryption of dumps. Empty = unencrypted (not
# recommended for anything leaving the machine).
BACKUP_PASSPHRASE=

# ---------------------------------------------------------------------------
# Image versions                                              REQUIRED
# ---------------------------------------------------------------------------
# Pinned on purpose. Verify each tag exists before the first deploy, then bump
# deliberately - never move any of these to :latest.
POSTGRES_IMAGE=postgres:16.6-alpine
REDIS_IMAGE=redis:7.4-alpine
N8N_IMAGE=n8nio/n8n:1.76.1
CADDY_IMAGE=caddy:2.8-alpine
